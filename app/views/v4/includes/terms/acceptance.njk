{% include "./changes-and-acceptance.njk" %}
    <form{% if termsWithAnchors %} id="terms-agreement" tabindex="-1"{% endif %} method="post" novalidate>
      {{ govukCheckboxes({
        name: "terms-accepted",
        idPrefix: "terms-accepted",
        errorMessage: { text: termsErrorMessage } if termsError,
        items: [{
          value: "accepted",
          text: "I have read and understood the requirements and principles for the acceptable use of HMPPS Digital Services."
        }]
      }) }}
      {{ govukButton({ text: "Continue" }) }}
    </form>
