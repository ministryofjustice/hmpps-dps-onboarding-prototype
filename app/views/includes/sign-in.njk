<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    {{ mojAlert({
      variant: "information",
      title: "You need to accept new terms and conditions",
      html: '<p class="govuk-body">You will be asked to accept our terms and conditions upon logging in soon. You can read <a class="govuk-link" href="terms-and-conditions">the terms and conditions</a> in advance.</p>'
    }) }}

    <h1 class="govuk-heading-l">Sign in</h1>
    <form method="post" novalidate>
      {{ govukInput({
        id: "username",
        name: "username",
        label: { text: "Username" },
        classes: "govuk-!-width-two-thirds",
        autocomplete: "username",
        spellcheck: false,
        attributes: { autocapitalize: "none" }
      }) }}

      {{ govukPasswordInput({
        id: "password",
        name: "_password",
        label: { text: "Password" },
        formGroup: { classes: "govuk-!-width-two-thirds" }
      }) }}

      {{ govukButton({ text: "Sign in", attributes: { "data-element-id": "continue-button" } }) }}
      <p class="govuk-body govuk-!-margin-bottom-8">
        <a class="govuk-link" href="#">Sign in with a justice.gov.uk email</a>
      </p>
    </form>

    <h2 class="govuk-heading-m">Problems signing in</h2>
    <p class="govuk-body"><a class="govuk-link" href="#">I have forgotten my password</a></p>
    <p class="govuk-body"><a class="govuk-link" href="#">I have forgotten my username</a></p>
    {{ govukDetails({
      summaryText: "Why won’t my password work?",
      html: '<p class="govuk-body">Your password is case-sensitive which means you must enter your password exactly as you first created it. For example if your password is <strong>H3LloWorlD</strong> you must enter it exactly like that.</p>'
    }) }}
  </div>
</div>
